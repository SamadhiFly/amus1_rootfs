#!/bin/bash

MOUNT_DIR=/mnt/p1
MMC_P1=/dev/mmcblk0p1
DEVINFO=devinfo

do_start()
{
	echo "Start initialising device...."

  # re-init eth1
  ifdown eth1
  sleep 2
  ifup eth1

	mkdir -p $MOUNT_DIR

	if ! mount $MMC_P1 $MOUNT_DIR ; then
		echo "Failed to mount $MMC_P1"
		return
	fi

	if [ ! -f "$MOUNT_DIR/$DEVINFO" ]; then 
		echo "file $MOUNT_DIR/$DEVINFO is not found!"
		umount $MOUNT_DIR
		return
	fi

	if [ ! -f "/home/thiss/.device_info" ]; then
		cp $MOUNT_DIR/$DEVINFO /home/thiss/.device_info
	else
		if diff "$MOUNT_DIR/$DEVINFO" "/home/thiss/.device_info" ; then
			echo "Device is already initialized!"
			umount $MOUNT_DIR
			return
		else
			cp $MOUNT_DIR/$DEVINFO /home/thiss/.device_info
		fi  
	fi		 

	chown thiss:thiss /home/thiss/.device_info

	DEVICE_ID=$(awk '{if(NR==1) print $1}' /home/thiss/.device_info)
	HW_ID=$(awk '{if(NR==3) print $1}' /home/thiss/.device_info)

	#echo "$DEVICE_ID * thiss" > /etc/ppp/chap-secrets
	echo "$HW_ID-$DEVICE_ID" > /etc/hostname
	
	# For a new device, files shall not present
	rm -rf /home/thiss/.GPS*
  rm -rf /home/thiss/wwwdata/*
  rm -rf /home/thiss/psd/*
	rm -rf /home/thiss/.local_cfg
	rm -rf /home/thiss/.gui_users*
	rm -rf /home/thiss/ocs.*
	rm -rf /home/thiss/.software/*
	rm -rf /home/thiss/.si/*		

	umount $MOUNT_DIR

	echo "done"
}

do_stop()
{
	echo "Stopping..."
}

case "$1" in
  start)
    do_start
    ;;

  stop)
    do_stop
    ;;

  restart)
    $0 stop
    sleep 1
    $0 start
    ;;

  reload|force-reload)
    ;;

  *)
    echo "Usage: /etc/init.d/init_devie {start|stop|reload|force-reload|restart}"
    exit 1
esac

exit 0

  
