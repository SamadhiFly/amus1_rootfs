#! /bin/sh
#
# This is an init script for openembedded
# Copy it to /etc/init.d/syslog-ng and type
# > update-rc.d syslog-ng defaults 5
#
MACHINE=$(uname -m)
if [ "$MACHINE" = "armv7l" ]; then
	syslog_ng=/usr/sbin/syslog-ng
else
	syslog_ng=/sbin/syslog-ng
fi

test -x "$syslog_ng" || exit 0

case "$1" in
  start)
    echo -n "Starting syslog-ng: "
    if /sbin/start-stop-daemon --start --quiet --exec $syslog_ng -- --cfgfile=/etc/syslog-ng.conf ; then
    	echo "OK"
		else
			echo "failed"
		fi
    ;;
  stop)
    echo -n "Stopping syslog-ng: "
    if /sbin/start-stop-daemon --stop --quiet -n syslog-ng ; then
			echo "OK"
		else
			echo "failed"
		fi
    ;;
  reload|force-reload)
		echo -n "Reloading syslog-ng: "	
    if /sbin/start-stop-daemon --stop --quiet --signal 1 --exec $syslog_ng -- --cfgfile=/etc/syslog-ng.conf ; then
			echo "OK"
		else
			echo "failed"
		fi
    ;;
  restart)
    echo -n "Stopping syslog-ng: "
    if /sbin/start-stop-daemon --stop --quiet -n syslog-ng ; then
    	echo "OK"
		else
			echo "failed"
		fi
		
		sleep 2 
    
		echo -n "Starting syslog-ng: "
    if /sbin/start-stop-daemon --start --quiet --exec $syslog_ng -- --cfgfile=/etc/syslog-ng.conf ; then
			echo "OK"
		else
			echo "failed"
		fi
    ;;
  *)
    echo "Usage: /etc/init.d/syslog-ng {start|stop|reload|restart|force-reload}"
    exit 1
esac

exit 0
