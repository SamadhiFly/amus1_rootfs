# db event log
filter f_db_events { facility(local0) and match("<event>"); };

# THISS logs 
filter f_user_log { facility(user); };

# Critical logs
filter f_critical_log {
#	 match("N:") 
#	 match(" W: ") or
	match(" E: ") or
	match(" C: ") or
	match(" A: ") or
	match(" P: ") or
	match("Setting process state to ONLINE") or
        match("Setting process state to OFFLINE") or 
	match("GPS lost fix") or
	match("GPS aquired fix")
; };

