#!/bin/bash

# Date: March 29, 2020
# Author: Angelo Zhang Bing An

VERSION=1 # Initial draft
VERSION=2 # Delete bmc_report_format table

bmc_sqlite=/home/bird/data/bmc_private.sqlite

print_usage()
{
    echo "Version $VERSION: init bmc private sqlite when install deb"
    echo "$(basename $0)"
    exit 1 
}

test_have_table()
{
    table_name=$1
    sqlite3 $bmc_sqlite "select count(*) from $table_name"
    return $?
}

update_bmc_db()
{
    sql='/tmp/bmc_sqlite_init.sql'
    cat << EOF > $sql
-- Auto generated by $(basename $0) Version $VERSION
-- Create table bmc_time_bucket to bmc_private.sqlite

create table bmc_time_bucket
(
    id integer primary key autoincrement,
    utc_start INT NOT NULL,
    utc_end INT NOT NULL,
    format_id TEXT NOT NULL,
    id_list TEXT NOT NULL
);

EOF
    echo "Create table bmc_time_bucket..."
    sqlite3 $bmc_sqlite < $sql
    if [ $? -eq 1 ]; then
        echo "sqlite running error"
        exit 1
    fi
}


########################################
# Main start here
########################################

test_have_table 'bmc_time_bucket'
if [ $? != 0 ]; then
    update_bmc_db
fi


