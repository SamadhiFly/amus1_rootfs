#!/bin/bash

######################################################################
# Copyright BIRD/Thiss Technologies
#
# Date: April 13, 2021
#
# backup /home/bird/data/gcoh.sqlite, manage the backup directory.
# Usage: see print_usage()
######################################################################

gcoh_dir=/home/bird/data/gcoh
mlimit=5 #default no more than 5MB
dlimit=90  #default no older than 90 days

print_usage()
{
  echo "Remove older GCOH files 1) if $gcoh_dir size exceeds ${mlimit}MB or 2) GCOH sqlite database files are older than $dlimit days"
  echo "Usage: $(basename $0) [-m mb] [-d days]"
}

while getopts ":m:d:" opt; do
  case "${opt}" in
    m)
      mlimit=$(echo "${OPTARG}" | awk '{printf("%d", $1)}')
    ;;
    d)
      dlimit=$(echo "${OPTARG}" | awk '{printf("%d", $1)}')
    ;;    
    *)
      print_usage
      exit 1
    ;;
  esac
done
shift $((OPTIND-1))

mkdir -p ${gcoh_dir}

# save_date=$(date -u +%Y%m%d%H%M%S)
save_date=$(date +%Y%m%d)_$(date +%H%M%S)
outfile="${gcoh_dir}/gcoh_${save_date}.sqlite"

# backup the database file in every day 00:00
/usr/bin/sqlite3 /home/bird/data/gcoh.sqlite ".dump" > /tmp/$save_date.sql

# If failed to create the dump, log error and exit
if [ ! -f /tmp/$save_date.sql ] ; then
  /usr/bin/write_log -p E "Save config was not successful"
  exit 1  
fi  

# Create the database file in persistent storage from the dump.
/usr/bin/sqlite3 $outfile < /tmp/$save_date.sql

if [ ! -f "$outfile" ]; then
  /usr/bin/write_log -p E "Save gcoh db was not successful"
  exit 1
fi

older_files=$( find ${gcoh_dir}/ -name "*.sqlite" -type f -mtime +${dlimit} -print )
if [ ! -z "$older_files" ]; then
  for f in $older_files ; do
    echo "Removing older file: $f" | /usr/bin/write_log -p W
    rm -rf ${f}
  done    
fi

while true ; do
  dir_size=$(du -m ${gcoh_dir} | tail -n 1 | awk '{printf("%d", $1)}')
  if [[ $dir_size -ge $mlimit ]]; then
    to_del=$(ls -t -1 ${gcoh_dir}/ | tail -1)
    echo "GCOH databases dir size=${dir_size}MB, removing file: $to_del" | /usr/bin/write_log -p W
    rm -rf ${gcoh_dir}/${to_del}
  else
    break
  fi
done

