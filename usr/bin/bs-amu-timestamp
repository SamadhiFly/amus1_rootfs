TIMESTAMP_FILE=/home/bird/data/.timestamp

#[337]  Incorrect power on/off reported time ZBA 2020.1.15 begin
#Reasons:For easier parsing

/bin/date -u +"%Y-%m-%d %H:%M:%S" >${TIMESTAMP_FILE}

#[337]  Incorrect power on/off reported time ZBA 2020.1.15 end

