# Utility function to change antenna hardware, see print_usage for more details



#VERSION=1 # Initial draft
VERSION=2  # Peer reviewed, minor touch of formatting
VERSION=3  # Use existing format version, use SQL json_extract to read self info 
VERSION=4  # A white box approach, parse and replace, instead of applying the whole JSON
VERSION=5  # Add some fileds in field_array
VERSION=6  # Fix bug, can't write events; Change bs-amu-logevent invocation mode

print_usage()
{
  echo "Version $VERSION: Change hardware information on AMU based on JSON file"
  echo "$(basename $0) -i job_id json_file"
  echo "Example change information based on /tmp/hi.json: $(basename $0) -i 100 /tmp/hw.json"
  exit 1 
}

insert_event()
{
  local event_id=404 # Hardware information changed
  local result=$1
    
  # TODO:
  # Check software upgrade event details in BMP
  # We can discuss more details with Rui Feng, and make it more consistent with the software upgrade process, and include additional information such as optional job ID 
  bs-amu-logevent -i $event_id -s 1 "{\"result\":\"$result\", \"job_id\":\"$job_id\"}"
}

# Read JSON file and verify it is valid JSON
read_json()
{
  #echo "json file pathname:$json_file"
  json_content=$(cat $json_file) # Dump JSON to json_content
  #echo $json_content

  python -c "import json; json_str=json.dumps($json_content); json.loads(json_str)"
  if [ $? -ne 0 ]; then
    insert_event 'Not valid JSON contents'
    exit 1
  fi

  # Get value from JSON, via python, see https://stackoverflow.com/questions/1955505/parsing-json-with-unix-tools
  for key in "${!field_array[@]}"; do
    field_array[$key]=$(python -c "import json, sys; json_str=json.dumps($json_content); hi_json = json.loads(json_str); print hi_json['$key']") 
    echo "JSON: $key: ${field_array[$key]}"
  done
}

update_db()
{
  sql='/home/bird/data/hi.sql'

  # Bash heredoc
  cat << EOF > $sql
-- Auto generated by $(basename $0) Version $VERSION
-- Update hardware information in config.sqlite
begin;
-- Copy the active record to a new row, but use -1 as its active flag
insert into config (utc_time_ms, active, group_name, group_type, saved_name, json_config) select strftime('%s','now')*1000, -1, group_name, group_type, saved_name, json_config from config where group_name = 'HI' and active > 0  order by id desc;

-- Deactivate existing HI
update config set active = 0 where group_name = 'HI' and active > 0;

EOF
  # Continue appending to the sql file, by manipulate new fields on the new row (active = -1)
  for key in "${!field_array[@]}"; do
    value=${field_array[$key]}
    if [ -n "$value" ]; then
      echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'HI' and active = -1 limit 1), '$.$key', '$value')) where group_name = 'HI' and active = -1;" >>$sql
    fi
  done

  # Activate the new row
  echo "update config set active = 1 where group_name = 'HI' and active = -1;" >>$sql
  echo "commit;" >>$sql
    
  sqlite3 /tmp/config.sqlite < $sql
    
  if [ $? -eq 1 ]; then
    insert_event 'Failed to update database'
    exit 1
  fi
}

