field_array['buc_model']=""
field_array['buc_serial']=""
field_array['lnb_model']=""
field_array['lnb_serial']=""
field_array['BMB_model']=""
field_array['box_sensor_pcb']=""
field_array['mechanical_version']=""
field_array['el_encoder_model']=""
field_array['az_encoder_model']=""
field_array['dish_sensor_pcb']=""
field_array['rl_encoder_model']=""
field_array['antenna_model']=""
field_array['base_sensor_pcb']=""
field_array['BMB_serial']=""



