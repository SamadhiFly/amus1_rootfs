# Obtain my own information
get_my_info()
{
  for key in "${!my_info[@]}"; do
    my_info[$key]=$(sqlite3 /tmp/config.sqlite "select json_extract((select json_config from config where group_name = 'HI' and active > 0 limit 1), '$.$key')") 
    echo "My info: $key: ${my_info[$key]}"
  done
}

get_old_values()
{
  for key in "${!field_array[@]}"; do
    old_values[$key]=$(sqlite3 /tmp/config.sqlite "select json_extract((select json_config from config where group_name = 'HI' and active > 0 limit 1), '$.$key')") 
  done
}

get_new_values()
{
  for key in "${!field_array[@]}"; do
    new_values[$key]=$(sqlite3 /tmp/config.sqlite "select json_extract((select json_config from config where group_name = 'HI' and active > 0 limit 1), '$.$key')") 
  done
}

print_result()
{
  local old
  local new
  local config

  for key in "${!field_array[@]}"; do
    old=${old_values[$key]}
    new=${new_values[$key]}
    config=${field_array[$key]}
    result='OK'
    changed='false'
    if [ -n "$config" ] && [ "$config" != "$new" ] ; then
      result='Failed'
    fi
    if [ "$old" != "$new" ]; then
      changed='true'
    fi

    echo "$key: config=($config) old=($old) new=($new) result=$result changed=$changed"
  done    
}

# Save cfg permanently after updating information
save()
{
  save_config # This is from PMT, save configuration
  if [ $? -ne 0 ]; then
    insert_event 'Failed to save config'
    exit 1 
  fi
}

reboot()
{
  # Copy from installer run.sh, reboot in one minute
  # -r reboot
  # -t n: send shutdown signal to process (including itself) after n seconds
  # +1: phystically shutdown after 1 minute

  echo "To be restarted in one minute"
  shutdown -r -t 10 +1
}

########################################
# Main start here
########################################
job_id='manual'
while getopts ":i:" opt; do
  case "${opt}" in
    i)
      job_id="$OPTARG"
      ;;       
    \?)
      echo "Invalid option ($OPTARG)"
      print_usage                
      ;;
  esac
done

shift $((OPTIND-1))

json_file=$1

if [ -z "$json_file" ]; then
  echo "JSON file required"
  print_usage 
fi

if [ ! -f "$json_file" ]; then
  echo "JSON file ($json_file) not found"
  print_usage 
fi

# Init field array, include only those fields that are interested to this script.
declare -A field_array # Associate array (key value pair) see https://www.artificialworlds.net/blog/2012/10/17/bash-associative-array-examples/
declare -A old_values
declare -A new_values

# TODO: Discuss with Qiao Yuan about additional fields that are allowed to be put in OTA
