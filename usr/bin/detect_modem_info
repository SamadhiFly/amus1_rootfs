#!/bin/bash

# Date: March 14, 2020
# Author: Zhang Bing An

# Utility function to detect modem had changed, then change antenna hardware, see print_usage for more details


VERSION=1
VERSION=2 # change to cron job call; call write_log write log file to pmt log file
VERSION=3 # if curl failed, then exit 1
modem_ip=192.168.0.1
#sleep_time=200

print_usage()
{
  echo "Version $VERSION: detect modem had changed, then update hi config"
  echo "$(basename $0)"
  echo "Example: $(basename $0)"
  exit 1 
}

update_db()
{
  sql='/home/bird/data/detect_modem.sql'
  
  # Bash heredoc                                                                                                                                                           
  cat << EOF > $sql
  -- Auto generated by $(basename $0) Version $VERSION
  -- Update hardware information in config.sqlite
  begin;
  -- Copy the active record to a new row, but use -1 as its active flag
  insert into config (utc_time_ms, active, group_name, group_type, saved_name, json_config) select strftime('%s','now')*1000, -1, group_name, group_type, saved_name, json_config from config where group_name = 'HI' and active > 0  order by id desc;
  
  -- Deactivate existing HI
  update config set active = 0 where group_name = 'HI' and active > 0;
  
EOF
  echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'HI' and active = -1 limit 1), '$.modem_mac', '$modem_mac')) where group_name = 'HI' and active = -1;" >>$sql
  echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'HI' and active = -1 limit 1), '$.modem_model', '$modem_model')) where group_name = 'HI' and active = -1;" >>$sql
  # Activate the new row
  echo "update config set active = 1 where group_name = 'HI' and active = -1;" >>$sql
  echo "commit;" >>$sql
    
  sqlite3 /tmp/config.sqlite < $sql
  if [ $? -eq 1 ]; then
    /usr/bin/write_log -p E "Filed to update database"
    exit 1
  fi
}

 # Save cfg permanently after updating information
save()
{
  save_config # This is from PMT, save configuration
  if [ $? -ne 0 ]; then
    /usr/bin/write_log -p E "Filed to save config"
    exit 1 
  fi
}

# we use curl request modem type
get_modem_type()
{
  local type_file='/tmp/modem_type'
  curl --connect-timeout 2 http://$modem_ip/cgi-bin/cgiclient -d'request={"FunctionName":"GetDeviceInformation"}' > $type_file
  #replace trur/false to python easy parse json
  sed -i 's/true/1/g' $type_file
  sed -i 's/false/0/g' $type_file
  local json_content=$(cat $type_file)
  #echo $json_content
  #{"RequestData":{"Authentication":{"CertificateValid":true,"ConfigSignatureValid":true},"Hardware":{"HardwareId":"NTC/2499.AA","HardwareVersion":"1","IdCode":"03414036-111","ModemType":"MDM2510","ProductionNumber":"190200079","SerialNumber":"00292321-111"},"Software":{"ActiveBank":0,"AlternateVersion":"4.2.0.14","CurrentVersion":"4.2.0.20","IsTryOtherBuild":false}},"RequestResult":{"Success":true}}
  local modem_type_tmp=$(python -c "import json, sys; json_str=json.dumps($json_content); result_dict=json.loads(json_str); print result_dict['RequestData']['Hardware']['ModemType'];")
  if [ -z $modem_type_tmp ];then
    /usr/bin/write_log -p E "curl request failed, modem_type is empty"
    exit 1
  fi
  #echo $modem_type_tmp
  local modem="Modem_"
  modem_model=$modem$modem_type_tmp
  #echo $modem_model
}

# we use curl request modem air mac
get_modem_mac_address()
{
  # tmp file 
  local tmp_file='/tmp/mac_address'
  #example result:{"RequestData":{"AirMACAddress":"00:06:39:8b:6b:7b"},"RequestResult":{"Success":true}} request_dic = json.loads(json_str);  print request_dic['RequestResult']
  curl --connect-timeout 2 http://$modem_ip/cgi-bin/cgiclient -d'request={"FunctionName":"GetAirMACAddress"}' > $tmp_file
  #replace trur/false to python easy parse json
  sed -i 's/true/1/g' $tmp_file
  sed -i 's/false/0/g' $tmp_file
  json_content=$(cat $tmp_file)
  #echo $json_content
  modem_mac=$(python -c "import json, sys; json_str=json.dumps($json_content); result_dict=json.loads(json_str); print result_dict['RequestData']['AirMACAddress'];")
  if [ -z $modem_mac ];then
    /usr/bin/write_log -p E "curl request failed, modem_mac is empty"
    exit 1
  fi
  #echo $modem_mac
}

# Obtain old modem info from config db
get_old_modem_info()
{
  old_modem_model=$(sqlite3 /tmp/config.sqlite "select json_extract((select json_config from config where group_name = 'HI' and active > 0 limit 1), '$.modem_model')")
  old_modem_mac=$(sqlite3 /tmp/config.sqlite "select json_extract((select json_config from config where group_name = 'HI' and active > 0 limit 1), '$.modem_mac')")
}

########################################
# Main start here
########################################
#    There is no need to insert events db because hardware info will be reported to bmp    

get_modem_mac_address
get_modem_type
get_old_modem_info

if [ "$modem_mac" != "$old_modem_mac" ] || [ "$modem_model" != "$old_modem_model" ]; then
  /usr/bin/write_log -p W "Detect modem info had changed"
  update_db
  save
fi


