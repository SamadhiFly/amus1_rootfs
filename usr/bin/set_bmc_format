#!/bin/bash

# Date: March 25, 2020
# Author: Angelo Zhang Bing An


VERSION=1 # Initial draft
VERSION=2 # change use database file; add job id 2020.3.29


print_usage()
{
    echo "Version $VERSION: setting bmc report's parameters on AMU"
    echo "$(basename $0) -s format -i [interval(default is 60)] -j job_id"
    echo "format:the name of format to be used, such as normal or full"
    echo "interval: historical status report OTA report interval, default is 60, same as the historical status generation interval in AMU."
    echo "Example Use full format with 1-minute report interval : set_bmc_format -s 'full' -i 60 -j job_id"
    exit 1 
}

insert_event()
{
    local event_id=404 # Hardware information changed
    local result=$1
    
    # TODO:
    # Check software upgrade event details in BMP
    # We can discuss more details with Rui Feng, and make it more consistent with the software upgrade process, and include additional information such as optional job ID 
    bs-amu-logevent -i $event_id -s 1 "{\"result\":\"$result\", \"job_id\":\"$job_id\"}"
}

validate_format_id()
{
    if [ -z "$format_id" ]; then
        print_usage
        exit 1
    fi

    if [[ $format_id == "normal" ]];then
    #do nothing
    do_nothing=1
    elif [[ $format_id == "full" ]]; then
    #do nothing  
    do_nothing=2
    else
        echo "'$format_id' is error input"
        print_usage
        exit 1
    fi
}

update_db()
{
    #sql='/home/bird/data/set_bmc_format.sql'
    sql='/tmp/set_bmc_format.sql'
    cat << EOF > $sql
-- Auto generated by $(basename $0) Version $VERSION
-- Update set bmc report to config.sqlite
begin;
-- Copy the active record to a new row, but use -1 as its active flag
insert into config (utc_time_ms, active, group_name, group_type, saved_name, json_config) select strftime('%s','now')*1000, -1, group_name, group_type, saved_name, json_config from config where group_name = 'BMC' and active > 0  order by id desc;

-- Deactivate existing BMC
update config set active = 0 where group_name = 'BMC' and active > 0;

EOF
    echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'BMC' and active = -1 limit 1), '$.statistics_interval_s', $report_interval)) where group_name = 'BMC' and active = -1;" >>$sql
    echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'BMC' and active = -1 limit 1), '$.format_id', '$format_id')) where group_name = 'BMC' and active = -1;" >>$sql
    # Activate the new row
    echo "update config set active = 1 where group_name = 'BMC' and active = -1;" >>$sql
    echo "commit;" >>$sql
    sqlite3 /tmp/config.sqlite < $sql

    if [ $? -eq 1 ]; then
        insert_event 'set bmc format, Failed to update database'
        exit 1
    fi
}

# Save cfg permanently after updating information
save()
{
    save_config # This is from PMT, save configuration
    if [ $? -ne 0 ]; then
        insert_event 'set bmc format, Failed to save config'
        exit 1 
    fi
}

active_config()
{
    pkill bmc
}

########################################
# Main start here
########################################
#default value
report_interval=60
format_id=''

if [[ $# < 4 ]]; then
    echo "input arg value is less than 4"
    print_usage
    exit 1
fi 

while getopts "s:i:j:" opt; do
    case "${opt}" in
        i)
            report_interval=$OPTARG
        ;;
        s)
            format_id=$OPTARG           
        ;;
        j)
            job_id=$OPTARG           
        ;;
        \?)
            echo "Invalid option ($OPTARG)"
            print_usage                
        ;;
    esac
done

validate_format_id

update_db

save

insert_event 'successful'
#kill bmc. pmt restart bmc
active_config
