#!/bin/bash

# Date: Oct 14, 2022
# Author: Emily Zhang Minli


VERSION=1 # Initial draft


print_usage()
{
    echo "Version $VERSION: setting bmc report event level on AMU"
    echo "$(basename $0) -e level -j job_id"
    echo "level:the lowest level of event that allowd to be report, such as 5 "
    echo "job_id:the job_id which is unique"
    echo "Example allow event has Notic level report to bmp : set_event_params -e 5 -j job_id"
    exit 1 
}

insert_event()
{
    local event_id=404 # Hardware information changed
    local result=$1
    
    # TODO:
    # Check software upgrade event details in BMP
    # We can discuss more details with Rui Feng, and make it more consistent with the software upgrade process, and include additional information such as optional job ID 
    bs-amu-logevent -i $event_id -s 1 "{\"result\":\"$result\", \"job_id\":\"$job_id\"}"
}

validate_event_level()
{
    if [ -z "$event_level" ]; then
        print_usage
        insert_event 'failed'
        write_log -p E "set_event_params validate_event_level failed and exit"
        exit 1
    fi

    if [[ $event_level -eq 0 ]]; then
      #do nothing
      do_nothing=1
    elif [[ $event_level -eq 1 ]]; then
      #do nothing
      do_nothing=2
    elif [[ $event_level -eq 2 ]]; then
      #do nothing
      do_nothing=3
    elif [[ $event_level -eq 3 ]]; then
      #do nothing
      do_nothing=4
    elif [[ $event_level -eq 4 ]]; then
      #do nothing
      do_nothing=5
    elif [[ $event_level -eq 5 ]]; then
      #do nothing
      do_nothing=6
    elif [[ $event_level -eq 6 ]]; then
      #do nothing
      do_nothing=7
    elif [[ $event_level -eq 7 ]]; then
      #do nothing
      do_nothing=8
    elif [[ $event_level -eq 8 ]]; then
      #do nothing
      do_nothing=9
    elif [[ $event_level -eq 9 ]]; then
      #do nothing
      do_nothing=10
    else 
        echo "level $event_level is not allowed "
        #print_usage
        insert_event 'failed'
        write_log -p E "set_event_params validate_event_level failed and exit"
        exit 1
    fi

}

update_db()
{
    #sql='/home/bird/data/set_event_params.sql'
    sql='/tmp/set_event_params.sql'
    cat << EOF > $sql
-- Auto generated by $(basename $0) Version $VERSION
-- Update set bmc report to config.sqlite
begin;
-- Copy the active record to a new row, but use -1 as its active flag
insert into config (utc_time_ms, active, group_name, group_type, saved_name, json_config) select strftime('%s','now')*1000, -1, group_name, group_type, saved_name, json_config from config where group_name = 'BMC' and active > 0  order by id desc;

-- Deactivate existing BMC
update config set active = 0 where group_name = 'BMC' and active > 0;

EOF
    echo "update config set json_config=(select json_replace((select json_config from config where group_name = 'BMC' and active = -1 limit 1), '$.event_level_min', $event_level)) where group_name = 'BMC' and active = -1;" >>$sql
    # Activate the new row
    echo "update config set active = 1 where group_name = 'BMC' and active = -1;" >>$sql
    echo "commit;" >>$sql
    sqlite3 /tmp/config.sqlite < $sql

    if [ $? -eq 1 ]; then
        insert_event 'failed'
        write_log -p E "set_event_params Failed to update database"
        exit 1
    fi
}

# Save cfg permanently after updating information
save()
{
    save_config # This is from PMT, save configuration
    if [ $? -ne 0 ]; then
        insert_event 'failed'
        write_log -p E "set_event_params Failed to save config"
        exit 1 
    fi
}

active_config()
{
    pkill bmc
}

########################################
# Main start here
########################################
#default value
event_level=5
debug_3=9
panic=0

if [[ $# < 4 ]]; then
    echo "input arg value is less than 4"
    print_usage
    write_log -p E "set_event_params input arg value is less than 4"
    exit 1
fi 

while getopts "e:j:" opt; do
    case "${opt}" in
        e)
            event_level=$OPTARG
        ;;
        j)
            job_id=$OPTARG           
        ;;
        \?)
            echo "Invalid option ($OPTARG)"
            print_usage                
        ;;
    esac
done

validate_event_level

update_db

save

insert_event 'successful'
write_log -p E "set_event_params successful"
#kill bmc. pmt restart bmc
active_config
