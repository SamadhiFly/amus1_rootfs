#!/bin/bash

PROG=/bin/regio
CTL_REG_OFFSET=0x25
PL_REG_BASE=0x0200

GPS_EN_STATE=0x18
RESPONSE="Y"
RESULT="0"
RESULT_NAMES=("PASSED" "FAILED - no DC" "FAILED - GPS not fixed over 10 minutes")
FNAME=$2
OUTFILE=""

if [ "$1" = "-o" ] && [ ! -z "$2" ] ; then
	OUTFILE=">> $2"
fi

echo "Testing GPS...."
echo "** if GPS antenna is connected to MDB02, disconnect it"

$PROG $(( CTL_REG_OFFSET + PL_REG_BASE )) $GPS_EN_STATE $DEBUG   

prompt()
{
	PROMPT="** press any key to continue..."
        if [ ! -z "$1" ]; then
                PROMPT="$1"
        fi
        
        read -s -r -p "$PROMPT" -n 1 RESPONSE

        echo 
}

print_result()
{
	if [ ! -z "$OUTFILE" ]; then
		echo "Saving test result to $FNAME"
	fi	

	echo "=================== GPS Test ==========================="	$OUTFILE
	echo "Test result           : ${RESULT_NAMES[$RESULT]}        " $OUTFILE
	echo "========================================================" $OUTFILE

	exit 0
} 

echo
echo "** now please measure GPS DC output from MDB02 GPS connector"
prompt "** enter Y if you can measure 2.5-5V DC from GPS connector, any other key if not :"

if [ "$RESPONSE" != "Y" ] ; then
	RESULT="1"
	print_result
fi

echo 
echo "** now connect GPS antenna to MDB02 and wait for at least 10 minutes"
echo "** GPS LED shall be flashing if GPS FIX is acquired" 
prompt "** press Y if you can observe GPS LED is flashing, any other key if not :"

if [ "$RESPONSE" != "Y" ]; then
	RESULT="2"
else
	RESULT="0"
fi

print_result

