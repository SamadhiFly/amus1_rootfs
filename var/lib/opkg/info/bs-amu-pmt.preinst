#!/bin/sh

#================================================================
# THISS Technology
# Sean Huang
# November 21, 2019
#
# This script performs preinst actions for the
# PMT package.
#
#================================================================

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>

MODULE=pmt

case "$1" in
  install|upgrade)
    echo ""
    echo "===== Preinstall Commencing : bs-amu-pmt ====="
    echo ""
    echo "===== Preinstall Complete : bs-amu-pmt ====="
    echo ""
    ;;

  abort-upgrade)
    ;;

  *)
    echo "preinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

exit 0


