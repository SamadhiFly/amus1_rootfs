drop table if exists role;
drop table if exists user;
drop table if exists params;
CREATE TABLE role
(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name VARCHAR (50, 255) UNIQUE,
    items VARCHAR (1000, 2000),
    created_at INTEGER (10, 10) DEFAULT (0),
    updated_at INTEGER (10, 10) DEFAULT (0),
    "is" INT (1, 1) DEFAULT (0)
);
INSERT INTO role
        (id, name, items, created_at, updated_at, "is")
    VALUES
        (1, 'admin', '["main","antennaLog","satConfigure","eventList","hardwareConfigure","functionConfigure","AGC","NetworkPortConfiguration","ImportExport","control","uerconfigure","roleconfigure","Logstatus"]', 1575958655, 1576129191, 1);

CREATE TABLE user
(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    account VARCHAR (5, 255) UNIQUE,
    password VARCHAR (1, 255) NOT NULL,
    salting VARCHAR (10, 50) NOT NULL,
    role INTEGER (1, 2) NOT NULL,
    created_at INTEGER (10, 10) NOT NULL,
    updated_at INTEGER (10, 10) NOT NULL,
    token VARCHAR (20, 255),
    ticket VARCHAR (20, 255)
);
