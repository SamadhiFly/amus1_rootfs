require_once '../include/auth_admin.php';
require_once '../include/db.php';
require_once '../include/functions.php';

$info = array();
// info is an array
function populateNetworkHtml($info, $type){
	$output = '';
	
	if($info[1] == 'N.A.'){
		return $output;
	}
	
	// WAN or virtual interface do not have MAC address
	if($type != 'wan' && $info[1] != 'virtual'){
		$output .= '<tr><td><b>MAC Address:</b></td><td colspan="3">'.$info[2].'</td></tr>';	
	}
	
	$output .= '<tr><td><b>IP Address:</b></td><td colspan="3">'.$info[3].'</td></tr>';
	
	if($type == 'wan'){
		$output .='<tr><td><b>Peer Address:</b></td><td colspan="3">'.$info[4].'</td></tr>';
	}else{
		$output .='<tr><td><b>Network Mask:</b></td><td colspan="3">'.$info[4].'</td></tr>';
	}
	
	// virtual interface do not have MTU, TX, RX statistics
	if($info[1] != 'virtual'){
		$output .='<tr><td><b>MTU:</b></td><td colspan="3">'.$info[5].'</td></tr>
		<tr><td width="150px"><b>RX Packets:</b></td><td width="175px">'.$info[6].'</td><td width="150px"><b>RX Bytes:</b></td><td width="175px">'.$info[7].'</td></tr>
		<tr><td><b>TX Packets:</b></td><td>'.$info[8].'</td><td><b>TX Bytes:</b></td><td>'.$info[9].'</td></tr>';
    }  
	return $output;
}


