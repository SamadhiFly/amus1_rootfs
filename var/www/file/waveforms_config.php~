<script>
var id;

function disableButton(disable, waveformId) {
  var edit_elm = document.getElementById("edit");
  var delete_elm = document.getElementById("delete");
  var details_elm = document.getElementById("details");

  if (edit_elm)
    edit_elm.disabled = disable;
  if (delete_elm)
    delete_elm.disabled = disable;
  if (details_elm)
    details_elm.disabled = disable;

  id = waveformId;
  
  if (disable == false)
  {
    if (edit_elm)
      edit_elm.addEventListener('click', editWaveform, false);
    if (delete_elm)
      delete_elm.addEventListener('click', deleteWaveform, false);
    if (details_elm)
      details_elm.addEventListener('click', detailWaveform, false);
  }
}

function editWaveform() {
  openwin('edit_waveform.php?id=' + id, 'load', '1150', '650');
}

function deleteWaveform() {
  var r = confirm("Are you sure you want to delete this waveform?");

  if (r==true)
    openwin('del_waveform.php?id=' + id, 'load', '500', '300');
}

function detailWaveform() {
  openwin('detail_waveform.php?id=' + id, 'load', '775', '650');
}
</script>
