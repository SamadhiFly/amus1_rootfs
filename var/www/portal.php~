	function process($username, $password)
	{
		$messages = array();
		$messages["usererror"] = "";
		$messages["passerror"] = "";
		$messages["loginmsg"] = "";
		$messages["result"] = "failed";

    if (empty($username))
    {
      $messages["usererror"] = "[406] Invalid account name";
			return $messages;
    }

    if (empty($password))
    {
      $messages["passerror"] = "[406] Invalid password";
			return $messages;
    }
		
    $pwd_md5 = md5($password);
    $ip = $_SERVER['REMOTE_ADDR'];
    $client_net_info = parse_ini_file("/home/thiss/wwwdata/client_net.cfg");
    $if = $client_net_info["interface"];
    $authsrvip = $client_net_info["auth_server_ip"];
    $authsrvport = $client_net_info["auth_server_port"];    
    $loginsrvip = $client_net_info["login_server_ip"];
    $loginsrvport = $client_net_info["login_server_port"];
    $mac = shell_exec("sudo /sbin/arp -an -i " . $if . " | grep " . $ip . " | awk '{print toupper($4)}'");

   	if (empty($ip) || empty($if) || empty($mac))
    {
    	$messages["loginmsg"] = "[502] Cannot determine your network addresses";
			return $messages;
    }

    $ip_allowed = shell_exec("sudo /usr/sbin/iptables --numeric --list --table mangle | grep " . $mac . " | awk '{print $4}'");

    if ($ip_allowed == $ip)
    {
    	$messages["loginmsg"] = "[202] You have logged in already";
			$messages["result"] = "successed";
			return $messages;
    }

    if (empty($authsrvip) || empty($authsrvport) || empty($loginsrvip) || empty($loginsrvport))
    {
    	$messages["loginmsg"] = "[501] Billing service is not configured on this network";
			return $messages;
    }

    $last_line = exec("sudo /usr/bin/tt-cu-clientauth " . $username . " " . $pwd_md5 . " " . $authsrvip . " " . $authsrvport,
               $output, $return_code);

		if ($return_code == 1)
		{
			$messages["loginmsg"] = "[503] Billing service is temporarily unavailable, please try again later";
			return $messages;
		}
		else if ($return_code == 2)
		{
			$messages["loginmsg"] = "[401] Failed to verify your account, incorrect password?";
			return $messages;
		}
		else if ($return_code == 3)
		{
			$messages["loginmsg"] = "[504] User account verification is encountering error(s)";
			return $messages;
		}
		else if ($return_code == 0)
		{
			;
		}
		else
		{
			$messages["loginmsg"] = "[500] Unknown errors";
			return $messages;
		}

    $last_line = exec("sudo /usr/bin/tt-cu-clientlogin " . $username . " " . $ip . " " . $loginsrvip . " " . $loginsrvport,
               $output, $return_code);

    if ($return_code == 1)
    {
      $messages["loginmsg"] = "[503] Billing service is temporarily unavailable, please try again later";
      return $messages;
    }
    else if ($return_code == 2)
    {
      $messages["loginmsg"] = "[402] Failed to enable your account, not enough credit?";
      return $messages;
    }
    else if ($return_code == 0)
    {
      $messages["loginmsg"] = "[200] You have successfully logged in to the network";
      $messages["result"] = "successed";
			
			$file = '/tmp/clients.data';
			$client = $ip . "\t" . $mac . "\n";
			file_put_contents($file, $client, FILE_APPEND | LOCK_EX);

      return $messages;
    }
    else
    {
      $messages["loginmsg"] = "[500] Unknown errors";
      return $messages;
    }

